# Copier ce fichier en .env et remplir les valeurs reelles.
# .env ne doit jamais etre versionne (voir .gitignore) - ENF-01 de la STB.

# Cles API testnet Binance (mode paper) - https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Cles API reelles Binance (mode live) - a ne remplir qu'une fois le mode paper valide
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ATTENTION : ce drapeau historique n'est LU PAR AUCUN CODE (verifie en
# 2026-09-17). Le laisser a false ne protege rien, le passer a true n'active
# rien. Le vrai verrou du trading reel est BINANCE_LIVE_TRADING_ENABLED
# ci-dessous. Conserve uniquement parce que ENF-02 de la STB le mentionne.
LIVE_TRADING_ENABLED=false

# Paper trading actions via Interactive Brokers (EF-65) - necessite TWS ou IB
# Gateway installe, lance, et connecte en mode PAPER (jamais LIVE tant que ce
# n'est pas explicitement voulu). Contrairement a Binance, pas de cle API :
# la connexion se fait par hote/port vers TWS/IB Gateway tournant en local.
# Ports par defaut : TWS paper = 7497, IB Gateway paper = 4002.
# ATTENTION : 7496 (TWS) et 4001 (IB Gateway) sont les ports LIVE (argent reel)
# - ne JAMAIS les utiliser ici tant que le passage en reel n'est pas voulu.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497

# ---------------------------------------------------------------------------
# TRADING AVEC DE L'ARGENT REEL (EF-69) - Binance, hors testnet
# ---------------------------------------------------------------------------
# Tout le reste de ce fichier concerne de l'argent FICTIF. Ce bloc-ci engage
# de vrai argent. Il ne s'active pas par erreur : le drapeau doit valoir
# EXACTEMENT la phrase ci-dessous, et plusieurs autres garde-fous refusent
# independamment de demarrer (voir execution/live_executor.py).
#
# AVANT DE CREER CES CLES, sur Binance :
#   - NE PAS activer les retraits ("Enable Withdrawals"). Le bot REFUSE de
#     demarrer avec une cle qui peut retirer : une fuite viderait le compte,
#     et c'est le seul risque impossible a reparer apres coup.
#   - Activer uniquement le trading spot.
#   - Restreindre la cle a ton adresse IP.
#
# BINANCE_LIVE_TRADING_ENABLED=oui-je-veux-trader-avec-de-l-argent-reel
BINANCE_LIVE_TRADING_ENABLED=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Plafond en USDT de CHAQUE ordre d'achat. Obligatoire et strictement positif :
# l'oublier empeche le demarrage plutot que d'ouvrir la vanne.
BINANCE_MAX_ORDER_NOTIONAL=

# Perte REALISEE maximale sur une journee (en USDT). Au-dela, plus aucun achat
# ne passe. Les ventes restent toujours autorisees : bloquer une sortie serait
# un garde-fou qui aggrave le risque.
BINANCE_MAX_DAILY_LOSS=

# ARRET D'URGENCE : creer un fichier nomme STOP_LIVE_TRADING a la racine du
# projet bloque immediatement TOUT ordre reel, achat comme vente, sans
# redemarrage ni dashboard. Le supprimer reautorise.

# ---------------------------------------------------------------------------
# ACCES AU DASHBOARD DEPUIS LES AUTRES APPAREILS DE LA MAISON (EF-82)
# ---------------------------------------------------------------------------
# Le serveur ecoute sur toutes les interfaces (DASHBOARD_BIND=0.0.0.0), mais
# il REFUSE tout appareil autre que la machine elle-meme tant que
# DASHBOARD_PASSWORD est vide : un dashboard qui sait passer des ordres et
# arreter des bots ne doit jamais etre ouvert sur un reseau par oubli.
# Le navigateur demande l'identifiant une fois, puis s'en souvient.
# Limite assumee : mot de passe transmis en clair sur le reseau LOCAL
# (pas de HTTPS) - convenable chez soi, pas sur un reseau public ni depuis
# Internet. Pour n'ecouter que localement : DASHBOARD_BIND=127.0.0.1
DASHBOARD_BIND=0.0.0.0
DASHBOARD_USER=trader
DASHBOARD_PASSWORD=
