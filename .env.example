# Copier ce fichier en .env et remplir les valeurs reelles.
# .env ne doit jamais etre versionne (voir .gitignore) - ENF-01 de la STB.

# Cles API testnet Binance (mode paper) - https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Cles API reelles Binance (mode live) - a ne remplir qu'une fois le mode paper valide
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Doit valoir exactement "true" pour autoriser le mode live (ENF-02 de la STB)
LIVE_TRADING_ENABLED=false
